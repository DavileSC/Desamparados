DATABASE_URL="mysql://usuario:contraseña@localhost:3306/desamparados_db"
DATABASE_HOST="localhost"
DATABASE_USER="usuario"
DATABASE_PASSWORD="contraseña"
DATABASE_NAME="desamparados_db"
JWT_SECRET="genera-un-secreto-de-al-menos-32-caracteres"
EMAIL_USER=""
EMAIL_PASS=""
CONTACT_EMAIL_TO=""
NODE_ENV="development"
NUM_PROXIES=0
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3001"

# ClamAV independiente (opcional)
# Servicio clamd independiente (no se ejecuta dentro de Node/Docker).
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
# true en producción: si clamd no responde, se rechaza la subida.
CLAMAV_REQUIRED=false

# URL pública del PDF de normativa enlazado en el pie de los correos.
# Si se deja vacía, el enlace simplemente no se pinta.
NORMATIVA_URL=

# Datos que se imprimen en la papeleta de sitio enviada por correo.
# Un valor equivocado aquí se envía a los hermanos y ya no se puede corregir.
PROCESION_FECHA="Sábado de Pasión"
PROCESION_HORA="19:30h"
PROCESION_ACCESO="Casa parroquial"
