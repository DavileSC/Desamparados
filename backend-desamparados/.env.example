# Plantilla del .env del backend. Cópiala a .env y rellénala.
# El servidor comprueba estas variables al arrancar (src/config/entorno.ts) y,
# si falta algo, se niega a arrancar y dice exactamente qué.

# ============================================================
# ENTORNO
# ============================================================
# Vacío a propósito: el servidor no arranca sin él. En tu equipo pon
# development; en el servidor, production. Sin production, todo el
# endurecimiento se apaga sin avisar (cookies sin Secure, sin HSTS, siembra con
# las contraseñas del repositorio). Solo valen development, test o production.
NODE_ENV=

# Puerto de la API. 3001 es al que apuntan el proxy de Vite y el nginx de
# docs/despliegue.md.
PORT=3001

# Interfaz en la que escucha. Sin definir: todas en desarrollo (el proxy de
# Vite usa localhost, que en Windows puede ser ::1) y solo 127.0.0.1 en
# producción, para que nadie llegue a Node sin pasar por nginx.
# HOST=127.0.0.1

# Cuántos proxies hay delante: 0 en tu equipo, 1 detrás de nginx.
# Obligatoria en producción. Mal puesta, se puede falsear la IP y saltarse los
# limitadores de intentos.
NUM_PROXIES=0

# ============================================================
# BASE DE DATOS (obligatorias siempre)
# ============================================================
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/desamparados_db"
DATABASE_HOST="localhost"
DATABASE_USER="usuario"
DATABASE_PASSWORD="contraseña"
DATABASE_NAME="desamparados_db"

# ============================================================
# SECRETOS
# ============================================================
# Firma de las sesiones. Obligatoria siempre; en producción, 32 caracteres
# como mínimo. Genera uno con: npm run gen:secret
JWT_SECRET=""

# Clave de cifrado del secreto del doble factor: exactamente 64 caracteres
# hexadecimales (32 bytes). Obligatoria en producción (el servidor no arranca
# sin ella o con otro formato); en desarrollo, si falta, se deriva de JWT_SECRET.
# Genera una con: npm run gen:clave-totp
#   (equivale a: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Después de ponerla por primera vez: npm run 2fa:cifrar-secretos
# Si se pierde, los cargos tendrán que volver a configurar el doble factor
# (npm run 2fa:rescatar -- correo, cuenta por cuenta).
TOTP_ENC_KEY=

# Solo durante una rotación de TOTP_ENC_KEY: la clave de antes. Se sigue
# leyendo con ella mientras npm run 2fa:cifrar-secretos lo pasa todo a la
# nueva; después se quita. Cambiar TOTP_ENC_KEY sin esto deja ilegibles todos
# los secretos y ningún cargo con 2FA puede entrar al CMS.
# Procedimiento completo: «Rotar TOTP_ENC_KEY» en docs/despliegue.md.
# TOTP_ENC_KEY_ANTERIOR=

# ============================================================
# URL PÚBLICAS
# ============================================================
# Origen de la web (CORS y enlaces de los correos) y base de las URL de los
# archivos subidos. Obligatorias en producción, y con https: en el servidor
# las dos son el mismo dominio (la API va bajo /api/).
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3001"

# ============================================================
# CORREO
# ============================================================
# Cuenta desde la que salen altas, recibos y recuperación de contraseña.
# Obligatorias en producción.
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM_NAME="Secretaría"
# Opcionales: un servicio de envío (Brevo) en vez de Gmail. Con EMAIL_SMTP_HOST,
# EMAIL_USER y EMAIL_PASS son el usuario y la clave SMTP del servicio, y
# EMAIL_FROM (obligatoria entonces) la dirección con la que salen los correos,
# dada de alta como remitente en el servicio. Sin host, Gmail.
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT=""
EMAIL_FROM=""
# A quién llegan los mensajes del formulario de contacto y el aviso de que ha
# entrado una solicitud de ingreso nueva; también es el «Responder a» de todos
# los correos (por defecto, EMAIL_FROM o EMAIL_USER).
# Opcional: cuántos correos de los envíos a muchos (comunicados, aviso de
# apertura de papeletas) salen al día; lo que no cabe, al día siguiente. Por
# defecto 250, por debajo de los 300 de Brevo gratis: los sueltos (altas,
# contraseñas) no cuentan y necesitan margen.
CORREOS_MASIVOS_POR_DIA=""
CONTACT_EMAIL_TO=""
# Opcionales: cuenta aparte para enviar el formulario de contacto. Si se dejan
# vacías se usa la de arriba.
CONTACT_EMAIL_USER=""
CONTACT_EMAIL_PASS=""
# SOLO EN LOCAL. Con "true", los correos NO se envían: cada uno se escribe como
# un .html abrible en backend-desamparados/storage/correos, con el sobre (de,
# para, asunto) en la cabecera. Sirve para revisar altas, aprobaciones y bajas
# sin tener credenciales de Gmail. Se ignora con NODE_ENV=production.
EMAIL_BUZON_PRUEBAS="false"

# ============================================================
# ANTIVIRUS (ClamAV)
# ============================================================
# Servicio clamd independiente (no se ejecuta dentro de Node).
#  - Sin CLAMAV_HOST no se analiza nada.
#  - Con CLAMAV_HOST, si clamd no responde, la subida se rechaza SIEMPRE,
#    también con CLAMAV_REQUIRED=false.
#  - CLAMAV_REQUIRED=true sin CLAMAV_HOST rechaza todas las subidas.
# En producción son obligatorias CLAMAV_HOST y CLAMAV_REQUIRED=true.
# CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# ============================================================
# AUDITORÍA
# ============================================================
# Días que se conservan los registros de auditoría (llevan IP y navegador).
# 730 por defecto: dos ejercicios contables. Mínimo 30.
# Los borra `npm run auditoria:purgar` (timer diario en el servidor).
AUDIT_RETENTION_DAYS=730

# ============================================================
# SIEMBRA (npm run seed)
# ============================================================
# En producción es obligatorio el correo del administrador; en desarrollo se
# usa admin@cofradia.com. Las contraseñas, si faltan, se generan en
# producción y se muestran una vez; en desarrollo son las del repositorio.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# 0 para no sembrar el censo de demostración (nunca se siembra en producción).
# SEED_DEMO=0

# ============================================================
# CONTENIDO DE LOS CORREOS
# ============================================================
# URL pública del PDF de normativa enlazado en el pie de los correos.
# Si se deja vacía, el enlace simplemente no se pinta. Si apunta a un PDF
# subido desde el CMS (/storage/public/<hex>.pdf), ese fichero cuenta como en
# uso y la limpieza de huérfanos no lo borra.
NORMATIVA_URL=

# ============================================================
# PAGO EN LÍNEA (área de hermanos)
# ============================================================
# redsys   → el TPV virtual del banco (tarjeta y, si está contratado, Bizum).
# simulado → se da por pagado sin mover dinero, para desarrollar sin banco.
# no       → apagado: se paga en Secretaría o en el reparto.
# Sin definir: simulado en desarrollo y apagado en producción.
# PAGO_EN_LINEA=redsys
#
# pruebas (por defecto) usa el entorno de pruebas de Redsys, que no cobra;
# sin claves propias usa las públicas de Redsys (tarjeta 4548 8100 0000 0003,
# 12/49, CVV 123). real cobra de verdad y exige las claves del banco.
# REDSYS_ENTORNO=pruebas
# REDSYS_COMERCIO=      # número de comercio (FUC)
# REDSYS_TERMINAL=1
# REDSYS_CLAVE=         # clave SHA-256 del portal del banco, 32 caracteres
# REDSYS_BIZUM=si       # solo si el banco tiene Bizum contratado en el TPV
#
# Con NODE_ENV=production, un pago de prueba (simulado, o redsys sin
# REDSYS_ENTORNO=real) impide arrancar: daría recibos por pagados sin cobrar.
# Solo la web de pruebas, que corre como producción, lo consiente así:
# PAGO_DE_PRUEBA_EN_PRODUCCION=si
#
# El banco avisa del cobro a API_URL/api/pagos/redsys/notificacion: tiene que
# ser una dirección pública (en local, por el túnel).

# --- Remesas SEPA (adeudos domiciliados) ---
# Los datos del Grupo como acreedor, para el fichero que Tesorería sube a la
# banca en línea. Sin ellos se ve qué recibos entrarían, pero no se genera
# nada. El identificador de acreedor lo da el banco al contratar los adeudos
# (en España, ES + dos dígitos de control + sufijo de 3 + el NIF). El BIC es
# opcional: con el IBAN basta.
# SEPA_ACREEDOR_NOMBRE=Grupo Parroquial Nuestra Senora de los Desamparados
# SEPA_ACREEDOR_ID=      # p. ej. ES26000G12345678
# SEPA_ACREEDOR_IBAN=    # la cuenta del Grupo donde se cobran los recibos
# SEPA_ACREEDOR_BIC=

# --- Aprobar la entrada al CMS desde el móvil ---
# Las claves VAPID con las que el servidor firma los avisos (Web Push). Sin
# ellas no hay avisos y el módulo «Aprobar la entrada desde el móvil» no se
# puede encender: se entra con el código de la app, como siempre. Se generan
# con npm run gen:vapid. Si se cambian, cada cargo tiene que volver a apuntar
# su móvil. VAPID_CONTACTO: a quién escribe el servicio de avisos si hay un
# problema (mailto:correo o una URL https).
# VAPID_PUBLICA=
# VAPID_PRIVADA=
# VAPID_CONTACTO=mailto:secretaria@example.org

# --- Boletín y avisos por correo ---
# Milisegundos entre correo y correo al enviar un boletín. La cuenta de Gmail
# corta a quien manda de golpe; con 1500 (por defecto) cuatrocientos correos
# tardan diez minutos. Con Google Workspace se puede bajar.
# COMUNICADOS_PAUSA_MS=1500
