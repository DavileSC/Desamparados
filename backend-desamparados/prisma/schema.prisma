// schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------
// ENUMS GLOBALES
// ---------------------------------------------------------

enum Role {
  USER // Hermano raso o Padre/Madre
  ADMIN // Informático
  TESORERIA // Tesorero
  ALBACERIA // Albacea
  HERMANO_MAYOR // Dashboard completo
  REDES // Community Manager
  SECRETARIA // Secretario
}

enum EstadoPago {
  PENDIENTE
  REMESADO // Enviado al banco en un lote (SEPA), esperando respuesta
  PAGADO
  DEVUELTO // El banco lo echa para atrás por falta de fondos
  ANULADO
  EXENTO
}

enum MetodoPago {
  EFECTIVO
  BIZUM
  TRANSFERENCIA
  TARJETA
  DOMICILIACION
}

enum TipoRecibo {
  PAPELETA_SITIO // <--- Uso principal actual
  CUOTA_HERMANO // <--- Preparado para el futuro
  DONATIVO
  OTRO
}

/// Cómo se paga la salida: una cuota fija (la papeleta de sitio) o la
/// voluntad que dice el hermano (el Rosario vespertino).
enum CobroSalida {
  CUOTA
  DONATIVO
}

/// De dónde sale la fecha cada año: de la Pascua (las de Semana Santa) o de
/// un acto de la Agenda que fija la Junta (Gloria, Rosario…).
enum FechaSalida {
  PASCUA
  MANUAL
}

/// Cada salida procesional de la corporación: las define el CMS, no el
/// código. Con papeletas no se borra: se desactiva.
model Salida {
  id              Int         @id @default(autoincrement())
  slug            String      @unique
  nombre          String
  /// «el», «la», «los» o «las»: con qué se escribe «del Sábado de Pasión» o «de la Procesión Magna».
  articulo        String      @default("el") @db.VarChar(3)
  orden           Int         @default(0)
  activa          Boolean     @default(true)
  conRopa         Boolean     @default(false)
  cobro           CobroSalida @default(CUOTA)
  importeCuota    Decimal     @default(0) @db.Decimal(8, 2)
  fecha           FechaSalida
  /// Con PASCUA: días desde el Domingo de Resurrección (Sábado de Pasión = −8).
  diasDesdePascua Int?
  /// Con PASCUA; con MANUAL salen del acto.
  horaSalida      String?
  lugar           String?
  /// Con MANUAL: el acto de la Agenda de este año.
  eventoId        Int?
  acto            Evento?     @relation("ActoDeLaSalida", fields: [eventoId], references: [id], onDelete: SetNull)
  plazoAbierto    Boolean     @default(false)
  plazoCambiadoEl DateTime?
  /// PuestoDelCatalogo[]: lo que sugieren la mesa y la solicitud.
  puestos         Json
  /// ConfiguracionCortejo; null = cuatro tramos de 30 con los puestos de la propia salida (cortejoPorDefecto).
  cortejo         Json?
  /// Vestimenta y comportamiento: van en la papeleta y en los correos.
  indicaciones    String?     @db.Text

  turnos      Turno[]
  papeletas   PapeletaSitio[]
  solicitudes Solicitud[]
}

enum EstadoCita {
  RESERVADA // El hermano ha dicho que viene
  ATENDIDA // Ya vino y se llevó la papeleta
  CANCELADA // El hermano anuló
  NO_PRESENTADO // No apareció
}

// ---------------------------------------------------------
// 1. GESTIÓN DE CUENTAS (LOGIN Y FAMILIAS)
// ---------------------------------------------------------

model User {
  id Int @id @default(autoincrement())

  // LOGIN
  email    String @unique
  password String

  // PERFIL DEL RESPONSABLE (ADMIN FIX)
  // Al tener estos datos aquí, el Admin puede loguearse sin ser Hermano.
  dni          String  @unique
  nombre       String
  apellidos    String
  telefono     String
  direccion    String?
  poblacion    String?
  codigoPostal String?

  role   Role    @default(USER)
  active Boolean @default(true) // Soft Delete del usuario

  // Invalidación de sesiones: todo JWT emitido ANTES de esta fecha queda anulado
  // (cambio de contraseña, degradación de rol, reset 2FA de emergencia...)
  tokenValidAfter DateTime @default(now())

  // Corte POR ÁREA. Las dos sesiones (CMS y hermanos) son independientes: salir
  // del área de hermanos no puede echar a nadie del CMS, y al revés. Un token
  // vale si se emitió después de tokenValidAfter Y de la marca de su área.
  cmsValidoDesde     DateTime @default(now())
  hermanoValidoDesde DateTime @default(now())

  // --- SEGURIDAD 2FA ---
  // Guardamos el secreto que comparte el servidor y el móvil del usuario
  twoFactorSecret   String?
  // Para saber si obligarle a meter el código o no
  twoFactorEnabled  Boolean @default(false)
  // Último intervalo TOTP (30 s) aceptado: impide reutilizar el mismo código
  // mientras siga dentro de su ventana de validez.
  twoFactorLastStep Int?

  // --- RECUPERACIÓN DE CONTRASEÑA ---
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // --- JUNTA DE GOBIERNO ---
  esJuntaDeGobierno Boolean @default(false)

  // RELACIÓN: Un usuario gestiona N hermanos (hijos, o él mismo)
  hermanos Hermano[]

  // RELACIÓN: Turnos de reparto donde trabaja como responsable (Junta de Gobierno)
  turnosResponsable Turno[] @relation("TurnosResponsables")

  // Códigos de respaldo del 2FA (de un solo uso, para perder/cambiar el móvil)
  backupCodes TwoFactorBackupCode[]

  // Registro de auditoría de las acciones que realiza este usuario (staff)
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// 2. LA FICHA DEL COFRADE
// ---------------------------------------------------------

// Quién es el menor para el adulto del que cuelga su ficha. No siempre es su
// hijo: un tío, un abuelo o un padrino pueden ejercer de tutor a efectos de la
// cofradía, y Secretaría necesita saber por qué esa ficha cuelga de esa cuenta
// (con un parentesco que no sea HIJO se pide la autorización de los padres).
enum Parentesco {
  HIJO
  SOBRINO
  NIETO
  AHIJADO
  OTRO
}

// Cómo se enseñan están en el frontend; aquí solo los valores posibles.
enum Sexo {
  HOMBRE
  MUJER
}

/// Quién es el titular de la cuenta del IBAN, visto desde la ficha: el propio
/// hermano, un familiar que también es hermano, u otra persona.
enum TitularidadCuenta {
  PROPIA
  FAMILIAR_HERMANO
  OTRA_PERSONA
}

/// Por qué salió del censo. Null en las bajas de antes de guardarlo.
enum MotivoBaja {
  VOLUNTARIA
  IMPAGO
  FALLECIMIENTO
  OTRO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  PAREJA_DE_HECHO
  SEPARADO
  DIVORCIADO
  VIUDO
}

model Hermano {
  id Int @id @default(autoincrement())

  // DATOS PERSONALES
  nombre          String
  /// Los dos apellidos juntos, como se buscan, se ordenan y se enseñan. Lo
  /// escribe el servidor a partir de los dos de abajo (domain/apellidos.ts):
  /// no se toca a mano, o se desacompasaría de ellos.
  apellidos       String
  primerApellido  String?
  segundoApellido String?
  dni             String?      @unique // Puede ser null (niños)
  fechaNacimiento DateTime
  sexo            Sexo?
  estadoCivil     EstadoCivil?
  profesion       String?
  /// «Natural de»: dónde nació.
  lugarNacimiento String?

  // CONTACTO ESPECÍFICO
  telefono          String?
  telefonoFijo      String?
  email             String?
  /// Un segundo correo, opcional: para quien quiere los avisos en dos sitios.
  email2            String?
  direccion         String?
  poblacion         String?
  codigoPostal      String?
  provincia         String?
  comunidadAutonoma String?
  pais              String?
  /// Quiere recibir el boletín de noticias por correo.
  boletin           Boolean @default(false)

  // VIDA COFRADE
  // Bautismo y parroquia son datos religiosos (RGPD, art. 9): opcionales, y
  // solo los ven el propio hermano y la gestión del censo.
  fechaBautismo     DateTime?
  /// «Bautizado/a en»: la localidad del bautismo.
  lugarBautismo     String?
  parroquiaBautismo String?
  /// Los tres siguientes los lleva Secretaría: el hermano los ve, no los edita.
  fechaJura         DateTime?
  /// Cuándo se le impuso la medalla del Grupo Parroquial.
  fechaMedalla      DateTime?
  /// Cómo se le nombra en las cartas y la papeleta («D.», «Dña.», «Rvdo. P.»…). Sin él, según el sexo.
  tratamiento       String?   @db.VarChar(40)
  presentadoPor     String?
  presentadoPor2    String?

  // DATOS DE HERMANDAD
  fechaAlta      DateTime    @default(now())
  activo         Boolean     @default(true) // Soft Delete del hermano
  numeroHermano  Int?        @unique // Número de hermano, si lo tienen asignado
  fechaBaja      DateTime? // Para saber cuándo dejó de pagar/salir
  motivoBaja     MotivoBaja?
  /// Si falleció, el día. Se pone al dar la baja por fallecimiento (sin él, el de la baja).
  fechaDefuncion DateTime?

  // VINCULACIÓN
  esTitular Boolean @default(false) // true = este perfil es el User logueado
  userId    Int
  user      User    @relation(fields: [userId], references: [id])

  /// Qué es este menor para el titular de la cuenta. Null en las fichas del
  /// propio titular y en las de antes de que existiera el campo.
  parentesco Parentesco?

  /// Cuándo pidió volver quien está de baja. La ficha de baja conserva su
  /// `fechaBaja` (borrarla perdería cuándo se fue), así que la petición se
  /// marca aquí y con eso entra en la cola de Secretaría. Se limpia al
  /// reactivarla o al rechazar la petición.
  reactivacionSolicitada DateTime?

  // --- DATOS LOGÍSTICOS (PROCESIÓN) ---

  tieneTunicaPropia Boolean @default(false)

  // TALLAJE DE ROPA (Nazarenos/Acólitos)
  // Talla genérica para previsión (Ej: "L", "42", "Niño 10")
  tunica String?

  // TALLAJE FÍSICO (Hombres de Trono)
  // Medida en cm desde suelo a hombro para cuadrar el varal (Ej: 165)
  alturaHombro Int?

  // ROL HABITUAL
  // Para mostrar en la ficha: "Fulanito (Hombre de Trono)" o "Fulanito (Músico)"
  puesto String?

  // Pago preferido para la generación de recibos (Domiciliación SEPA preparada)
  formaPagoPref     MetodoPago         @default(EFECTIVO)
  iban              String?
  /// Nombre del titular de la cuenta, cuando no es el propio hermano.
  titularCuenta     String?
  titularidadCuenta TitularidadCuenta?
  /// Cuándo autorizó el adeudo (el mandato SEPA): al domiciliar o al cambiar de
  /// cuenta, porque una cuenta nueva es un mandato nuevo. Va en cada remesa.
  fechaMandato      DateTime?

  // DOCUMENTOS DEL ALTA (en storage/private: solo los ve el CMS). Guardan el
  // nombre del fichero, no la URL, para no atarse al dominio de la API.
  foto                String?
  certificadoBautismo String?

  // HISTORIAL
  papeletas          PapeletaSitio[]
  recibos            Recibo[]
  citas              Cita[]
  transacciones      Transaccion[]
  prendas            Prenda[]
  solicitudes        Solicitud[]
  /// Los cabildos a los que asistió.
  asistenciasCabildo CabildoAsistencia[]
  sufragios          Sufragio[]

  // Las peticiones de reactivación son pocas y Secretaría las lee enteras cada
  // vez que abre la cola: así no hay que recorrer el censo para encontrarlas.
  @@index([reactivacionSolicitada])
}

// ---------------------------------------------------------
// 3. SISTEMA DE ASISTENCIA (EL DÍA DE REPARTO)
// ---------------------------------------------------------

// Los días que la Hermandad abre para atender
model Turno {
  id    Int      @id @default(autoincrement())
  fecha DateTime // Ej: 2024-03-15

  horaInicio DateTime // Ej: 18:00
  horaFin    DateTime // Ej: 21:00

  // Informativo: ¿Cuánta gente esperamos poder atender bien?
  capacidadEstimada Int @default(100)

  /// De qué salida es el reparto: cada salida pide los suyos por separado.
  salidaId Int
  salida   Salida @relation(fields: [salidaId], references: [id])

  /// El acto de la Agenda pública que anuncia este día de reparto, para que
  /// la gente sepa cuándo ir a apuntarse. Se crea y se borra con el turno.
  eventoId Int?    @unique
  evento   Evento? @relation(fields: [eventoId], references: [id], onDelete: SetNull)

  activo Boolean @default(true)

  citas Cita[] // Lista de gente que dijo que vendría

  // RELACIÓN: Miembros de la Junta que trabajan ese día
  responsables User[] @relation("TurnosResponsables")

  @@index([salidaId])
}

// La intención de ir de un hermano
model Cita {
  id Int @id @default(autoincrement())

  // No guardamos hora exacta, solo el vínculo con el turno
  estado EstadoCita @default(RESERVADA)

  // RELACIONES
  turnoId Int
  turno   Turno @relation(fields: [turnoId], references: [id])

  hermanoId Int
  hermano   Hermano @relation(fields: [hermanoId], references: [id])

  // Opcional: Si la cita se completó, generó una papeleta
  papeleta  PapeletaSitio?
  solicitud Solicitud?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restricción: Un hermano solo sale una vez por turno
  @@unique([hermanoId, turnoId])
}

// ---------------------------------------------------------
// 4. ECONOMÍA
// ---------------------------------------------------------

// Mantenemos solo el tipo básico
enum TipoTransaccion {
  INGRESO
  GASTO
}

// NUEVO: Modelo dinámico de categorías
model CategoriaTransaccion {
  id             Int             @id @default(autoincrement())
  nombre         String // Ej: "Lotería Navidad", "Flores Cuaresma"
  tipo           TipoTransaccion // Para saber si debe salir en el desplegable de Ingresos o de Gastos
  activa         Boolean         @default(true) // Soft-delete: si ya no venden lotería, la ocultan pero no se borra el historial
  /// La cuenta del plan de las entidades sin fines lucrativos para la partida
  /// doble. Null: la que se propone por el nombre (domain/partida-doble.ts).
  cuentaContable String?         @db.VarChar(10)

  transacciones Transaccion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El servicio ya lo comprueba, pero dos altas a la vez podían colarse. Con la
  // intercalación utf8mb4_unicode_ci el índice no distingue mayúsculas ni tildes.
  @@unique([tipo, nombre])
}

// EL LIBRO MAYOR (Actualizado)
model Transaccion {
  id   Int             @id @default(autoincrement())
  tipo TipoTransaccion

  // Enlace a la nueva tabla
  categoriaId Int
  categoria   CategoriaTransaccion @relation(fields: [categoriaId], references: [id])

  concepto   String
  importe    Decimal     @db.Decimal(10, 2)
  fecha      DateTime    @default(now())
  metodoPago MetodoPago?

  hermanoId Int?
  hermano   Hermano? @relation(fields: [hermanoId], references: [id])
  reciboId  Int?
  recibo    Recibo?  @relation(fields: [reciboId], references: [id])

  /// Si es la liquidación de un talonario de lotería, o la compra de sus décimos.
  talonarioLoteria TalonarioLoteria?
  compraDeLoteria  SorteoLoteria?
  /// Si es una venta de la caja de la tienda: se corrige desde la caja, no a mano.
  ventaDeCaja      CajaVenta?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recibo {
  id Int @id @default(autoincrement())

  year         Int // Año fiscal
  concepto     String // "Papeleta de Sitio 2024"
  importe      Decimal  @db.Decimal(10, 2)
  fechaEmision DateTime @default(now())

  tipo TipoRecibo @default(PAPELETA_SITIO)

  estado        EstadoPago  @default(PENDIENTE)
  fechaPago     DateTime?
  metodoPago    MetodoPago?
  observaciones String?     @db.Text

  // RELACIONES
  hermanoId Int
  hermano   Hermano       @relation(fields: [hermanoId], references: [id])
  recibos   Transaccion[] // Un recibo puede tener varias transacciones (Ej: Papeleta + Donativo)

  // Relación opcional: Si es papeleta, se rellena.
  papeleta  PapeletaSitio?
  /// Lo pagado por una solicitud antes de recogerla.
  solicitud Solicitud?
  /// La remesa que lo mandó al banco, si se cobró (o se intentó) por domiciliación.
  remesaId  Int?
  remesa    Remesa?        @relation(fields: [remesaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hermanoId, year, concepto])
  @@index([year]) // <-- Búsquedas de tesorería mucho más rápidas
  @@index([hermanoId]) // <-- Para listar rápido los recibos de una familia
  @@index([remesaId])
}

enum EstadoRemesa {
  ENVIADA // El fichero está generado; el banco aún no ha cargado los adeudos
  COBRADA // Tesorería la dio por cobrada: los recibos que seguían remesados, pagados
}

/// Un lote de adeudos domiciliados (SEPA CORE) para subir a la banca en línea.
/// Guarda el fichero tal cual salió: si se pierde o hay que reenviarlo, se
/// descarga el mismo, con los mismos identificadores que el banco ya conoce.
model Remesa {
  id          Int          @id @default(autoincrement())
  /// El MsgId del fichero: el banco rechaza dos ficheros con el mismo.
  mensajeId   String       @unique @db.VarChar(35)
  /// El día en que el banco carga los adeudos (ReqdColltnDt).
  fechaCobro  DateTime     @db.Date
  numRecibos  Int
  total       Decimal      @db.Decimal(10, 2)
  xml         String       @db.LongText
  estado      EstadoRemesa @default(ENVIADA)
  cobradaEl   DateTime?
  /// Quién la generó, copiado: la remesa sobrevive a la cuenta del tesorero.
  autorId     Int?
  autorNombre String?

  recibos Recibo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ---------------------------------------------------------
// 5. LA PROCESIÓN (PAPELETA DE SITIO)
// ---------------------------------------------------------

model PapeletaSitio {
  id       Int    @id @default(autoincrement())
  year     Int
  salidaId Int
  salida   Salida @relation(fields: [salidaId], references: [id])

  // SITIO
  puesto String // "Cirio", "Varita", "Diputado", "hombre de trono"
  tramo  String? // "Tramo 3 Virgen"
  numero Int? // Orden de antigüedad

  // ASIGNACIÓN DE MATERIAL (ROPA QUE SE LLEVA ESE AÑO)
  numTunicaAsignada   String? // Ej: "140-05" (Código inventario)
  numCapiroteAsignado String? // Ej: "135"
  /// La faraona de los niños de guardería, numerada aparte de los capirotes.
  numFaraonaAsignada  String?
  /// De dónde sale la túnica: del ropero, propia o ninguna (mantilla). Null
  /// en las papeletas de antes de la mesa y en las del Rosario (de traje).
  origenTunica        OrigenTunica?
  /// El cíngulo: se presta (y se devuelve con el resto de la ropa), o no
  /// había y se le debe, o lleva el suyo, o no lleva. Los cíngulos son
  /// todos iguales: no van numerados, se cuentan. Null en el Rosario (de
  /// traje) y en las papeletas de antes.
  cingulo             Cingulo?
  observaciones       String?

  /// Cuándo entró en el templo para la salida: lo apunta quien escanea el QR
  /// en la puerta (o lo marca a mano si no trae la papeleta). Null: aún no.
  entradaEl  DateTime?
  /// Quién lo apuntó, copiado: el registro sobrevive a la cuenta de quien escanea.
  entradaPor String?   @db.VarChar(120)

  // RELACIONES
  hermanoId Int
  hermano   Hermano @relation(fields: [hermanoId], references: [id])

  // ECONOMÍA: Vinculamos al recibo que pagó esto
  reciboId Int    @unique
  recibo   Recibo @relation(fields: [reciboId], references: [id])

  // LOGÍSTICA: ¿Vino de una cita previa?
  citaId Int?  @unique
  cita   Cita? @relation(fields: [citaId], references: [id])

  /// La solicitud de la que salió, si la hubo.
  solicitud Solicitud?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un hermano sale una vez por salida y año.
  @@unique([hermanoId, year, salidaId])
  @@index([year, salidaId])
}

/// La solicitud de salir: la hace el hermano desde su área (eligiendo día de
/// reparto) o la apunta la mesa en Inscripción. No es todavía una papeleta ni
/// genera recibo: la papeleta nace cuando se recoge en Túnicas (con la ropa,
/// o con el puesto confirmado en el Rosario). Si no aparece a recogerla, no
/// queda nada que anular.
model Solicitud {
  id       Int    @id @default(autoincrement())
  year     Int
  salidaId Int
  salida   Salida @relation(fields: [salidaId], references: [id])

  /// El puesto que pide. Lo decide el Grupo: en Túnicas se confirma o se cambia.
  puesto        String
  /// La voluntad que dijo dar en el Rosario, en euros. Se cobra en Tesorería
  /// (o en línea) y puede cambiar al pagar. Null en la Pasión.
  donativo      Decimal?        @db.Decimal(10, 2)
  observaciones String?
  origen        OrigenSolicitud
  estado        EstadoSolicitud @default(PENDIENTE)

  hermanoId Int
  hermano   Hermano @relation(fields: [hermanoId], references: [id])

  /// El día de reparto que eligió, si lo eligió.
  citaId Int?  @unique
  cita   Cita? @relation(fields: [citaId], references: [id])

  /// Lo pagado por la salida (la cuota de salida o el donativo), si se pagó
  /// antes de recoger. Al recoger pasa a ser el recibo de la papeleta.
  reciboId Int?    @unique
  recibo   Recibo? @relation(fields: [reciboId], references: [id])

  /// La papeleta que salió de ella, al recogerla.
  papeletaId Int?           @unique
  papeleta   PapeletaSitio? @relation(fields: [papeletaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year, salidaId, estado])
  @@index([hermanoId, year, salidaId])
}

enum OrigenSolicitud {
  WEB
  MESA
}

enum EstadoSolicitud {
  PENDIENTE
  RECOGIDA
  CANCELADA
}

enum OrigenTunica {
  ROPERO
  PROPIA
  NINGUNA
}

/// Qué pasa con el cíngulo de una papeleta.
enum Cingulo {
  PRESTADO // Se lo llevó: cuenta como fuera del ropero hasta que lo devuelve
  DEBIDO // No quedaban: hay que dárselo cuando lo haya
  PROPIO // Lleva el suyo
  NINGUNO // No lleva (mantilla, sin túnica)
  DEVUELTO // Lo prestado ya volvió al ropero
}

// ---------------------------------------------------------
// 6. EVENTOS Y CALENDARIO
// ---------------------------------------------------------

enum TipoEvento {
  CULTO
  PROCESION
  FORMACION
  ENSAYO
  REUNION
  SOCIAL
  OTRO
}

model Evento {
  id          Int       @id @default(autoincrement())
  title       String
  description String?   @db.Text
  location    String?
  startDate   DateTime
  endDate     DateTime?

  // Todos los actos son públicos: la agenda no tiene actos solo para hermanos.
  type TipoEvento @default(OTRO)

  /// Si lo puso la procesión al crear un día de reparto: se borra con él.
  turno Turno?

  /// Las salidas con fecha a mano que toman de aquí su día y su lugar.
  salidas Salida[] @relation("ActoDeLaSalida")

  /// Los cultos solemnes salen en la Agenda pública como un cartel, con su
  /// foto y su dedicatoria («en honor de Nuestra Señora de los Desamparados»).
  /// Sin foto, la web pone la de la Titular en los cultos y la de la
  /// procesión en las salidas.
  cartel      Boolean @default(false)
  dedicatoria String?
  fotoCartel  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate]) // <-- Para que el calendario cargue al instante
}

// ---------------------------------------------------------
// 7. ALBACERÍA (INVENTARIO ESTÁTICO)
// ---------------------------------------------------------

// 1. LOS ENSERES (Gestión por Lotes: Hachetas, Viacrucis, Varales)
model Enser {
  id         Int     @id @default(autoincrement())
  nombre     String
  referencia String?
  categoria  String?
  ubicacion  String?

  cantidadOptimo  Int @default(0)
  cantidadBueno   Int @default(0)
  cantidadReparar Int @default(0)
  cantidadTotal   Int @default(0)

  imagenUrl        String?
  fechaAdquisicion DateTime?

  // LA FICHA DE PATRIMONIO: lo que piden el seguro, el Obispado o una
  // restauración. Todo opcional: un lote de hachetas no necesita autor.
  descripcion   String?   @db.Text
  /// Autor, taller u orfebre.
  autor         String?   @db.VarChar(160)
  /// Texto libre: «1958», «hacia 1890», «s. XVIII».
  epoca         String?   @db.VarChar(80)
  materiales    String?   @db.VarChar(255)
  dimensiones   String?   @db.VarChar(120)
  /// El estado de conservación y las intervenciones (restauraciones, limpiezas).
  conservacion  String?   @db.Text
  /// Más fotos de la pieza, además de la principal: [{ url, pie }].
  fotos         Json?
  valorTasacion Decimal?  @db.Decimal(12, 2)
  fechaTasacion DateTime?
  tasadoPor     String?   @db.VarChar(160)
}

// 2. EL ROPERO (Gestión Unitaria: Túnicas, Capirotes, Faraonas)
model Prenda {
  id            Int          @id @default(autoincrement())
  /// Único dentro de su tipo: capirotes y faraonas se numeran cada uno desde
  /// el 1, y el capirote 18 y la faraona 18 son prendas distintas.
  numero        String // Ej: "145-31" (túnica), "150" (capirote), "21M" (faraona)
  tipo          TipoPrenda // Enum a crear: TUNICA, CAPIROTE, FARAONA, CAPA
  talla         String? // Ej: "1.75m", "XL"
  estado        EstadoPrenda @default(DISPONIBLE) // DISPONIBLE, PRESTADA, LAVADO, TALLER (rota, para arreglar), BAJA
  observaciones String?

  // Relación: ¿Quién se la ha llevado a casa?
  hermanoId       Int?
  hermano         Hermano?  @relation(fields: [hermanoId], references: [id])
  fechaAsignacion DateTime?

  @@unique([tipo, numero])
}

enum TipoPrenda {
  TUNICA
  CAPIROTE
  FARAONA
  CAPA
  OTRO
}

enum EstadoPrenda {
  DISPONIBLE
  PRESTADA
  /// Devuelta y en el lavado: todas las túnicas se lavan al volver.
  LAVADO
  /// Rota: para arreglar.
  TALLER
  BAJA
}

// ---------------------------------------------------------
// 8. NOTICIAS Y CONFIGURACIÓN
// ---------------------------------------------------------

model Noticia {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  titulo    String
  extracto  String?
  contenido String   @db.Text
  imagenUrl String?
  fecha     DateTime @default(now())
  visible   Boolean  @default(true)
  /// La destacada de la portada: encabeza la rejilla y las otras dos plazas
  /// siguen siendo las más recientes. Solo una a la vez (fijar una suelta la
  /// anterior) y solo si está publicada. El archivo no la mira: ahí manda la fecha.
  fijada    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La web pública filtra por visible y ordena por fecha; el CMS ordena por
  // fecha sin filtrar. Mismo par de índices que Publicacion, que se consulta igual.
  @@index([visible, fecha])
  @@index([fecha])
}

enum TipoPublicacion {
  boletin
  dossier
  anuario
  historia
}

model Publicacion {
  id          Int             @id @default(autoincrement())
  titulo      String
  descripcion String?         @db.Text
  imagenUrl   String?
  archivoUrl  String
  fecha       DateTime        @default(now())
  categoria   TipoPublicacion
  visible     Boolean         @default(true)
  /// La destacada de la portada, igual que en Noticia: una sola, publicada, y
  /// ocupa el puesto grande del bloque de Publicaciones.
  fijada      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoria, fecha])
  @@index([visible, fecha])
}

/// Cómo va un pago con la pasarela del banco (Redsys).
/// Qué se paga en línea: recibos y salidas del área de hermanos, un pedido de
/// la tienda o un apadrinamiento.
enum OrigenPago {
  AREA_HERMANOS
  TIENDA
  APADRINAMIENTO
}

enum EstadoPagoEnLinea {
  PENDIENTE // El hermano está en la página del banco, o la dejó sin pagar
  PAGADO // El banco avisó de que se cobró y los recibos quedaron pagados
  RECHAZADO // El banco avisó de que no se cobró (tarjeta denegada, cancelado…)
  INCIDENCIA // Se cobró, pero no cuadra con lo que debía: Tesorería lo devuelve
}

/// Qué se paga: recibos del área de hermanos o un donativo desde la web pública.
enum TipoPagoEnLinea {
  RECIBOS
  DONATIVO
}

/// Un pago que pasa por el banco: recibos del área de hermanos o un donativo. Se apunta antes de ir a
/// la página de Redsys, con lo que se paga y el importe calculado aquí; solo el
/// aviso firmado del banco lo da por pagado, nunca la vuelta del navegador.
model PagoEnLinea {
  id           Int               @id @default(autoincrement())
  /// El número de pedido para Redsys: 12 caracteres, los 4 primeros cifras.
  pedido       String?           @unique @db.VarChar(12)
  /// Quién paga, si tiene cuenta. La tienda, los apadrinamientos y los
  /// donativos de la web pública se pagan sin ella.
  userId       Int?
  /// De dónde viene el pago, y qué se paga fuera del área de hermanos.
  origen       OrigenPago        @default(AREA_HERMANOS)
  referenciaId Int?
  tipo         TipoPagoEnLinea   @default(RECIBOS)
  /// Del donativo: el destino que eligió, la página desde la que donó y, si
  /// los dio, su nombre y su correo (para darle las gracias).
  donativo     Json?
  /// TARJETA o BIZUM.
  metodo       MetodoPago
  importe      Decimal           @db.Decimal(10, 2)
  reciboIds    Json
  solicitudIds Json
  estado       EstadoPagoEnLinea @default(PENDIENTE)
  /// El código de respuesta del banco (Ds_Response) y su autorización.
  respuesta    String?           @db.VarChar(8)
  autorizacion String?           @db.VarChar(12)
  /// Qué no cuadró, en una incidencia; y quién la dio por resuelta.
  motivo       String?           @db.Text
  resueltaPor  Int?
  resueltaEl   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([estado, createdAt])
}

/// Una búsqueda del CMS guardada con nombre («Menores con túnica propia»):
/// los filtros tal como van en la URL del listado. Las comparte toda la junta.
model ListaGuardada {
  id        Int      @id @default(autoincrement())
  /// De qué listado es: hoy, «censo».
  pantalla  String   @db.VarChar(30)
  nombre    String   @db.VarChar(80)
  /// Los filtros, como la consulta de la URL (`estado=activo&edad=menores`).
  consulta  String   @db.Text
  autorId   Int?
  createdAt DateTime @default(now())

  @@unique([pantalla, nombre])
}

enum TipoSufragio {
  MISA_FUNERAL
  MISA_ANIVERSARIO
  MISA_SUFRAGIO
  ORACION
}

/// Lo que el Grupo Parroquial ofrece por un hermano difunto: la misa del
/// funeral, las de aniversario, otras misas y oraciones. Puede ir a la Agenda.
model Sufragio {
  id             Int          @id @default(autoincrement())
  hermanoId      Int
  hermano        Hermano      @relation(fields: [hermanoId], references: [id])
  tipo           TipoSufragio
  fecha          DateTime
  lugar          String?      @db.VarChar(200)
  notas          String?      @db.Text
  /// El acto de la Agenda, si se publicó.
  eventoId       Int?
  /// Cuándo se avisó a la familia por correo, si se avisó.
  familiaAvisada DateTime?
  createdAt      DateTime     @default(now())

  @@index([hermanoId, fecha])
}

/// Una carta o circular de Secretaría: el texto con sus campos
/// ({{nombre}}…), la firma y a quién va (los filtros del censo, como la URL).
/// Se guarda para reutilizarla de un año a otro.
model Carta {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(120)
  asunto      String   @db.VarChar(200)
  cuerpo      String   @db.Text
  consulta    String   @db.Text
  firmaCargo  String   @db.VarChar(80)
  firmaNombre String?  @db.VarChar(120)
  autorId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Lo que ya hizo la mesa, por la clave que el ordenador genera al abrir cada
/// operación. Si se corta la WiFi después de cobrar y la mesa vuelve a pulsar,
/// la misma clave devuelve lo que ya se hizo en vez de cobrar otra vez.
model OperacionMesa {
  clave     String   @id @db.VarChar(64)
  tipo      String   @db.VarChar(40)
  resultado Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Configuracion {
  key         String   @id
  value       String
  descripcion String?
  updatedAt   DateTime @updatedAt
}

// Códigos de respaldo del 2FA: se muestran UNA sola vez al activar,
// y cada uno puede usarse una única vez (para login o para desactivar).
model TwoFactorBackupCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Registro de auditoría de acciones sensibles (dinero, roles, solicitudes, RGPD).
// Es la prueba forense de quién hizo qué, cuándo y desde qué IP.
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // Ej: 'RECIBO_COBRAR', 'SOLICITUD_APROBAR' (ver AUDIT_ACTIONS)
  entityType String? // 'recibo', 'hermano', 'user', 'config'...
  entityId   String? // ID del registro afectado (string para flexibilidad)
  ip         String?
  userAgent  String?  @db.VarChar(250)
  // Estado anterior y nuevo, u otros datos que expliquen el cambio.
  detalles   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Pagina {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  titulo    String
  contenido String   @db.Text
  updatedAt DateTime @updatedAt
}

// Fotos que rotan en la cabecera de la portada, en el orden en que se enseñan.
// El CMS las sustituye en bloque (PUT /api/portada/imagenes); con la tabla
// vacía, la web pública enseña su foto de siempre.
model ImagenPortada {
  id          Int      @id @default(autoincrement())
  url         String
  descripcion String?
  orden       Int
  createdAt   DateTime @default(now())

  @@index([orden])
}

// Contenido editable de una página: un documento por página, validado contra su
// esquema antes de escribirse. La ESTRUCTURA la fija el código (qué bloques hay
// y en qué orden); esto guarda solo lo que dentro de ella se puede cambiar,
// textos e imágenes. Dos filas: 'portada' y 'recorrido'.
//
// OJO: si un campo de `datos` apunta a /storage/public, tiene que contar en
// `utils/ficheros-publicos.ts` o el limpiador de huérfanos borrará la foto
// estando publicada.
model ContenidoPagina {
  slug      String   @id
  datos     Json
  updatedAt DateTime @updatedAt
}

// Cada guardado de una página deja aquí una copia del documento entero, con
// quién y cuándo: el historial del constructor de páginas, desde el que se
// puede volver a una versión anterior. Se guardan las últimas por página (ver
// `VERSIONES_POR_PAGINA` en contenido.service.ts).
//
// El autor va copiado (id y nombre) y no como relación: una versión tiene que
// seguir diciendo quién la hizo aunque esa cuenta se borre.
//
// OJO: como `ContenidoPagina`, sus fotos cuentan en `utils/ficheros-publicos.ts`:
// si no, restaurar una versión devolvería fotos ya borradas del disco.
model VersionContenido {
  id          Int      @id @default(autoincrement())
  slug        String
  datos       Json
  autorId     Int?
  autorNombre String   @default("")
  createdAt   DateTime @default(now())

  @@index([slug, createdAt])
}

// Secciones guardadas del constructor: uno o varios bloques con un nombre, para
// ponerlos igual en otra página. Se guardan ya validados, con la misma regla
// que los bloques de una página.
model SeccionGuardada {
  id          Int      @id @default(autoincrement())
  nombre      String
  bloques     Json
  autorId     Int?
  autorNombre String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Avisos de la junta: lo que un cargo apunta a mano en el Inicio del CMS para
// otro cargo o para toda la junta («Preparar el orden del día del cabildo»).
// Salen entre los asuntos de «Hoy» hasta que alguien los da por hecho; entonces
// no se borran, se marcan (y la auditoría guarda quién y cuándo).
model AvisoJunta {
  id          Int       @id @default(autoincrement())
  texto       String    @db.VarChar(160)
  // Para quién: un cargo, o null si es para toda la junta.
  para        Role?
  // Fecha límite opcional: pasada y sin hacer, el aviso se pone urgente solo.
  hasta       DateTime? @db.Date
  urgente     Boolean   @default(false)
  // Quién lo creó y con qué cargo («de Secretaría»). Sin relación: el aviso
  // no debe impedir nada sobre la cuenta, y el cargo ya queda guardado aquí.
  creadoPorId Int?
  creadorRol  Role
  createdAt   DateTime  @default(now())
  hechoAt     DateTime?
  hechoPorId  Int?

  @@index([hechoAt])
}

// ---------------------------------------------------------
// EL INFORME ANUAL
// ---------------------------------------------------------
// Los textos que se escriben a mano antes de generar el Informe anual en PDF:
// la presentación del Hermano Mayor, el epílogo del Secretario y una nota de
// patrimonio (estrenos, restauraciones y donaciones). El resto del Informe
// sale de las cifras de conjunto. Una fila por año natural: el Grupo lleva su
// ejercicio del 1 de enero al 31 de diciembre.
model InformeAnual {
  anio              Int      @id
  presentacion      String?  @db.Text
  firmaPresentacion String?  @db.VarChar(120)
  lugarFecha        String?  @db.VarChar(120)
  epilogo           String?  @db.Text
  firmaEpilogo      String?  @db.VarChar(120)
  notaPatrimonio    String?  @db.Text
  // «Presentado al Cabildo General de hermanos el …», en la portada.
  fechaCabildo      String?  @db.VarChar(120)
  updatedAt         DateTime @updatedAt
}

enum TipoComunicado {
  BOLETIN // Solo a quien está suscrito: es su consentimiento
  AVISO // Comunicación del Grupo a los activos del segmento (cuotas, cabildos…)
}

enum EstadoComunicado {
  BORRADOR
  ENVIANDO // Hay envíos pendientes: el servidor los va mandando poco a poco
  ENVIADO
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADO
  FALLIDO
}

/// Un boletín o un aviso masivo por correo. El cuerpo, saneado como el resto
/// del contenido del CMS; a quién va, por el segmento elegido.
model Comunicado {
  id          Int               @id @default(autoincrement())
  tipo        TipoComunicado
  asunto      String            @db.VarChar(150)
  cuerpo      String            @db.LongText
  /// Los filtros del segmento, tal como se eligieron (ver domain/comunicados.ts).
  segmento    Json
  estado      EstadoComunicado  @default(BORRADOR)
  enviadoEl   DateTime?
  /// Quién lo escribió y quién lo mandó, copiados: sobreviven a las cuentas.
  autorId     Int?
  autorNombre String?
  envios      ComunicadoEnvio[]
  /// El cabildo del que es convocatoria, si lo es.
  cabildos    Cabildo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Cada destinatario de un comunicado. Se apuntan todos al pulsar «Enviar» y
/// el servidor los va mandando: si se reinicia a medias, sigue por donde iba
/// y a nadie le llega dos veces.
model ComunicadoEnvio {
  id           Int         @id @default(autoincrement())
  comunicadoId Int
  comunicado   Comunicado  @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  email        String      @db.VarChar(191)
  /// A quién saluda: el nombre si la dirección es de una sola ficha.
  nombre       String?
  sexo         Sexo?
  estado       EstadoEnvio @default(PENDIENTE)
  enviadoEl    DateTime?

  @@unique([comunicadoId, email])
  @@index([comunicadoId, estado])
}

enum TipoCabildo {
  ORDINARIO
  EXTRAORDINARIO
}

enum EstadoCabildo {
  CONVOCADO // Con fecha y orden del día; aún no se ha celebrado
  CELEBRADO // Ya se celebró: asistencia y votaciones apuntadas, el acta en redacción
  ACTA_APROBADA // El acta está aprobada: pasa al libro de actas y ya no se toca
}

enum Mayoria {
  SIMPLE // Más votos a favor que en contra
  DOS_TERCIOS // Dos tercios de los votos emitidos (reforma de reglas, por ejemplo)
}

/// Un cabildo de hermanos: su convocatoria, quién asistió, qué se votó y su acta.
model Cabildo {
  id             Int           @id @default(autoincrement())
  tipo           TipoCabildo
  fecha          DateTime
  lugar          String        @db.VarChar(191)
  /// Los puntos del orden del día, en orden.
  ordenDelDia    Json
  estado         EstadoCabildo @default(CONVOCADO)
  /// Al darlo por celebrado se guarda el censo con voto de ese día: el quórum
  /// del acta no debe cambiar si mañana hay altas o bajas.
  censoConVoto   Int?
  enSegunda      Boolean       @default(false)
  acta           String        @default("") @db.LongText
  actaAprobadaEl DateTime?
  /// El borrador de aviso con la convocatoria, en Boletín y avisos.
  convocatoriaId Int?
  convocatoria   Comunicado?   @relation(fields: [convocatoriaId], references: [id], onDelete: SetNull)

  asistencias CabildoAsistencia[]
  votaciones  CabildoVotacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
}

model CabildoAsistencia {
  id           Int      @id @default(autoincrement())
  cabildoId    Int
  cabildo      Cabildo  @relation(fields: [cabildoId], references: [id], onDelete: Cascade)
  hermanoId    Int
  hermano      Hermano  @relation(fields: [hermanoId], references: [id], onDelete: Cascade)
  registradaEl DateTime @default(now())

  @@unique([cabildoId, hermanoId])
  @@index([hermanoId])
}

model CabildoVotacion {
  id           Int      @id @default(autoincrement())
  cabildoId    Int
  cabildo      Cabildo  @relation(fields: [cabildoId], references: [id], onDelete: Cascade)
  asunto       String   @db.VarChar(300)
  mayoria      Mayoria  @default(SIMPLE)
  aFavor       Int
  enContra     Int
  abstenciones Int
  createdAt    DateTime @default(now())

  @@index([cabildoId])
}

enum EstadoPedido {
  PENDIENTE_PAGO // Se ha ido al banco y aún no ha avisado
  PAGADO // Cobrado: espera a que lo recojan en Secretaría
  ENTREGADO
  CANCELADO // El banco no lo cobró, o se anuló
}

/// Lo que se vende en la tienda de la web: recuerdos, medallas, estampas…
model Producto {
  id           Int                 @id @default(autoincrement())
  nombre       String              @db.VarChar(120)
  descripcion  String              @default("") @db.Text
  precio       Decimal             @db.Decimal(10, 2)
  /// URL de la foto, subida desde el CMS.
  foto         String?
  /// Cuántos quedan. Null: sin límite (se hace por encargo).
  existencias  Int?
  activo       Boolean             @default(true)
  orden        Int                 @default(0)
  lineas       PedidoTiendaLinea[]
  /// Lo vendido en la caja de la tienda.
  lineasDeCaja CajaVentaLinea[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([activo, orden])
}

/// Un pedido de la tienda. Se compra sin cuenta y se recoge en Secretaría.
model PedidoTienda {
  id          Int                 @id @default(autoincrement())
  /// Para la página de vuelta del banco: sin él, nadie ve un pedido ajeno.
  token       String              @unique @db.VarChar(32)
  nombre      String              @db.VarChar(120)
  email       String              @db.VarChar(191)
  telefono    String              @db.VarChar(30)
  estado      EstadoPedido        @default(PENDIENTE_PAGO)
  total       Decimal             @db.Decimal(10, 2)
  metodo      MetodoPago?
  pagadoEl    DateTime?
  entregadoEl DateTime?
  lineas      PedidoTiendaLinea[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([estado, createdAt])
}

/// Una plantilla de correo (sección Emails del CMS). Cada una es para un uso
/// (la bienvenida, la papeleta, el pésame… ver shared/usos-de-correo.json) y
/// de cada uso hay como mucho una en uso; sin ninguna, sale el texto original.
model PlantillaCorreo {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(120)
  uso         String   @db.VarChar(40)
  asunto      String   @db.VarChar(200)
  titulo      String   @db.VarChar(200)
  cuerpo      String   @db.Text
  despedida   String   @default("") @db.VarChar(300)
  enUso       Boolean  @default(false)
  /// Quién la cambió por última vez, copiado: sobrevive a la cuenta.
  autorNombre String?  @db.VarChar(120)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uso, enUso])
}

/// Una caja de la tienda, del abrir al cerrar: lo que se vende en persona en
/// Secretaría o en la casa del Grupo. Solo hay una abierta a la vez; al
/// cerrarla se cuenta el efectivo y queda escrito lo que debía haber.
model CajaSesion {
  id               Int         @id @default(autoincrement())
  abiertaEl        DateTime    @default(now())
  /// Quién la abrió y quién la cerró, copiados: la caja sobrevive a la cuenta.
  abiertaPor       String?     @db.VarChar(120)
  /// El cambio con que se empieza.
  fondoInicial     Decimal     @db.Decimal(10, 2)
  cerradaEl        DateTime?
  cerradaPor       String?     @db.VarChar(120)
  /// Lo que debía haber en efectivo (fondo y ventas en efectivo) y lo que se contó.
  efectivoEsperado Decimal?    @db.Decimal(10, 2)
  efectivoContado  Decimal?    @db.Decimal(10, 2)
  observaciones    String?     @db.Text
  ventas           CajaVenta[]

  @@index([cerradaEl])
  @@index([abiertaEl])
}

/// Una venta de la caja. Apunta su ingreso en la contabilidad al momento; si
/// se anula (solo con la caja abierta), el apunte se quita y vuelven las existencias.
model CajaVenta {
  id            Int              @id @default(autoincrement())
  sesionId      Int
  sesion        CajaSesion       @relation(fields: [sesionId], references: [id], onDelete: Restrict)
  total         Decimal          @db.Decimal(10, 2)
  metodo        MetodoPago
  vendidaEl     DateTime         @default(now())
  vendedor      String?          @db.VarChar(120)
  anuladaEl     DateTime?
  anuladaPor    String?          @db.VarChar(120)
  transaccionId Int?             @unique
  transaccion   Transaccion?     @relation(fields: [transaccionId], references: [id], onDelete: SetNull)
  lineas        CajaVentaLinea[]

  @@index([sesionId])
}

/// Lo vendido: un producto del catálogo, o algo suelto escrito a mano.
model CajaVentaLinea {
  id         Int       @id @default(autoincrement())
  ventaId    Int
  venta      CajaVenta @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId Int?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  /// Nombre y precio copiados, como en los pedidos en línea.
  nombre     String    @db.VarChar(120)
  precio     Decimal   @db.Decimal(10, 2)
  cantidad   Int

  @@index([ventaId])
}

model PedidoTiendaLinea {
  id         Int          @id @default(autoincrement())
  pedidoId   Int
  pedido     PedidoTienda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId Int?
  producto   Producto?    @relation(fields: [productoId], references: [id], onDelete: SetNull)
  /// Nombre y precio copiados: el pedido no cambia si mañana cambia el producto.
  nombre     String       @db.VarChar(120)
  precio     Decimal      @db.Decimal(10, 2)
  cantidad   Int

  @@index([pedidoId])
}

/// Una campaña de apadrinamiento: una foto (el trono, el manto, la
/// candelería) con sus piezas marcadas encima, para que cada una la costee
/// quien quiera.
model CampanaApadrinamiento {
  id          Int                @id @default(autoincrement())
  titulo      String             @db.VarChar(150)
  descripcion String             @default("") @db.Text
  foto        String
  activa      Boolean            @default(true)
  piezas      PiezaApadrinable[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// Una pieza sobre la foto, en porcentaje del ancho y del alto (así sirve a
/// cualquier tamaño de pantalla). Se apadrina una vez.
model PiezaApadrinable {
  id              Int                   @id @default(autoincrement())
  campanaId       Int
  campana         CampanaApadrinamiento @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  nombre          String                @db.VarChar(120)
  precio          Decimal               @db.Decimal(10, 2)
  x               Decimal               @db.Decimal(5, 2)
  y               Decimal               @db.Decimal(5, 2)
  /// El apadrinamiento pagado, cuando lo hay.
  apadrinamientos Apadrinamiento[]

  @@index([campanaId])
}

/// Quien apadrina una pieza. Sin cuenta, como la tienda.
model Apadrinamiento {
  id                Int              @id @default(autoincrement())
  token             String           @unique @db.VarChar(32)
  piezaId           Int
  pieza             PiezaApadrinable @relation(fields: [piezaId], references: [id], onDelete: Cascade)
  nombre            String           @db.VarChar(120)
  email             String           @db.VarChar(191)
  telefono          String           @db.VarChar(30)
  dedicatoria       String?          @db.VarChar(200)
  /// Si quiere que su nombre salga en la foto.
  mostrarNombre     Boolean          @default(false)
  /// Para el certificado de donación y el Modelo 182, si lo pidió: su NIF,
  /// su nombre y sus apellidos por separado (el `nombre` de arriba es el que
  /// sale en la foto, y Hacienda los pide en orden) y su código postal (de él
  /// sale la provincia).
  nif               String?          @db.VarChar(9)
  nombreFiscal      String?          @db.VarChar(120)
  apellidosFiscales String?          @db.VarChar(120)
  codigoPostal      String?          @db.VarChar(5)
  estado            EstadoPedido     @default(PENDIENTE_PAGO)
  importe           Decimal          @db.Decimal(10, 2)
  metodo            MetodoPago?
  pagadoEl          DateTime?
  createdAt         DateTime         @default(now())

  @@index([piezaId, estado])
}

/// Dónde va el cortejo en la calle, para el mapa del recorrido. Una sola fila
/// (id 1): solo interesa la última posición, no el rastro.
model CortejoEnDirecto {
  id            Int      @id @default(1)
  /// Si está en la calle. Al terminar se apaga y el mapa vuelve a la reproducción.
  enMarcha      Boolean  @default(false)
  lng           Decimal  @db.Decimal(9, 6)
  lat           Decimal  @db.Decimal(9, 6)
  /// Metros de margen que da el GPS; null si se marcó a mano una parada.
  precision     Int?
  /// Quién la manda, para saber a quién llamar si se queda parada.
  autorId       Int?
  autorNombre   String?  @db.VarChar(120)
  actualizadoEl DateTime @default(now())
}

/// Un sorteo de lotería en que juega el Grupo: compra décimos de uno o varios
/// números y los reparte en participaciones, que se venden en talonarios.
model SorteoLoteria {
  id                  Int                @id @default(autoincrement())
  /// «Lotería de Navidad 2026».
  nombre              String             @db.VarChar(120)
  fecha               DateTime           @db.Date
  /// Los números que juega y, tras el sorteo, lo que gana un décimo de cada
  /// uno: [{ "numero": "04512", "premio": null }]. Ver domain/loteria.ts.
  numeros             Json
  precioDecimo        Decimal            @db.Decimal(10, 2)
  /// Décimos comprados de cada número.
  decimos             Int
  /// Lo que paga quien compra una participación…
  precioParticipacion Decimal            @db.Decimal(10, 2)
  /// …y lo que juega de eso, repartido entre los números. La diferencia es donativo.
  jugado              Decimal            @db.Decimal(10, 2)
  porTalonario        Int
  /// El texto legal de la participación. Vacío: el de domain/loteria.ts.
  leyenda             String             @default("") @db.Text
  /// El gasto de la compra de los décimos, si ya se apuntó.
  compraId            Int?               @unique
  compra              Transaccion?       @relation(fields: [compraId], references: [id], onDelete: SetNull)
  talonarios          TalonarioLoteria[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([fecha])
}

/// Un talonario de participaciones: a quién se le dio para venderlo y, al
/// devolverlo, cuántas vendió. Su numeración sale del número de talonario.
model TalonarioLoteria {
  id            Int           @id @default(autoincrement())
  sorteoId      Int
  sorteo        SorteoLoteria @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  numero        Int
  /// Quien lo vende: un hermano, un bar del barrio… Null: en Secretaría, sin dar.
  responsable   String?       @db.VarChar(120)
  telefono      String?       @db.VarChar(30)
  entregadoEl   DateTime?
  /// Al liquidarlo: las vendidas (las demás se devuelven) y cómo se pagó.
  vendidas      Int?
  metodoPago    MetodoPago?
  liquidadoEl   DateTime?
  /// El ingreso de la liquidación en la contabilidad.
  transaccionId Int?          @unique
  transaccion   Transaccion?  @relation(fields: [transaccionId], references: [id], onDelete: SetNull)

  @@unique([sorteoId, numero])
}
