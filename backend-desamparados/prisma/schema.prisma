// schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------
// ENUMS GLOBALES
// ---------------------------------------------------------

enum Role {
  USER // Hermano raso o Padre/Madre
  ADMIN // Informático
  TESORERIA // Tesorero
  ALBACERIA // Albacea
  HERMANO_MAYOR // Dashboard completo
  REDES // Community Manager
  SECRETARIA // Secretario
}

enum EstadoPago {
  PENDIENTE
  REMESADO // Enviado al banco en un lote (SEPA), esperando respuesta
  PAGADO
  DEVUELTO // El banco lo echa para atrás por falta de fondos
  ANULADO
  EXENTO
}

enum MetodoPago {
  EFECTIVO
  BIZUM
  TRANSFERENCIA
  TARJETA
  DOMICILIACION
}

enum TipoRecibo {
  PAPELETA_SITIO // <--- Uso principal actual
  CUOTA_HERMANO // <--- Preparado para el futuro
  DONATIVO
  OTRO
}

enum EstadoCita {
  RESERVADA // El hermano ha dicho que viene
  ATENDIDA // Ya vino y se llevó la papeleta
  CANCELADA // El hermano anuló
  NO_PRESENTADO // No apareció
}

// ---------------------------------------------------------
// 1. GESTIÓN DE CUENTAS (LOGIN Y FAMILIAS)
// ---------------------------------------------------------

model User {
  id Int @id @default(autoincrement())

  // LOGIN
  email    String @unique
  password String

  // PERFIL DEL RESPONSABLE (ADMIN FIX)
  // Al tener estos datos aquí, el Admin puede loguearse sin ser Hermano.
  dni          String  @unique
  nombre       String
  apellidos    String
  telefono     String
  direccion    String?
  poblacion    String?
  codigoPostal String?

  role   Role    @default(USER)
  active Boolean @default(true) // Soft Delete del usuario

  // Invalidación de sesiones: todo JWT emitido ANTES de esta fecha queda anulado
  // (cambio de contraseña, degradación de rol, reset 2FA de emergencia...)
  tokenValidAfter DateTime @default(now())

  // Corte POR ÁREA. Las dos sesiones (CMS y hermanos) son independientes: salir
  // del área de hermanos no puede echar a nadie del CMS, y al revés. Un token
  // vale si se emitió después de tokenValidAfter Y de la marca de su área.
  cmsValidoDesde     DateTime @default(now())
  hermanoValidoDesde DateTime @default(now())

  // --- SEGURIDAD 2FA ---
  // Guardamos el secreto que comparte el servidor y el móvil del usuario
  twoFactorSecret  String?
  // Para saber si obligarle a meter el código o no
  twoFactorEnabled Boolean @default(false)
  // Último intervalo TOTP (30 s) aceptado: impide reutilizar el mismo código
  // mientras siga dentro de su ventana de validez.
  twoFactorLastStep Int?

  // --- RECUPERACIÓN DE CONTRASEÑA ---
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // --- JUNTA DE GOBIERNO ---
  esJuntaDeGobierno Boolean @default(false)

  // RELACIÓN: Un usuario gestiona N hermanos (hijos, o él mismo)
  hermanos Hermano[]

  // RELACIÓN: Turnos de reparto donde trabaja como responsable (Junta de Gobierno)
  turnosResponsable Turno[] @relation("TurnosResponsables")

  // Códigos de respaldo del 2FA (de un solo uso, para perder/cambiar el móvil)
  backupCodes TwoFactorBackupCode[]

  // Registro de auditoría de las acciones que realiza este usuario (staff)
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// 2. LA FICHA DEL COFRADE
// ---------------------------------------------------------

// Quién es el menor para el adulto del que cuelga su ficha. No siempre es su
// hijo: un tío, un abuelo o un padrino pueden ejercer de tutor a efectos de la
// cofradía, y Secretaría necesita saber por qué esa ficha cuelga de esa cuenta
// (con un parentesco que no sea HIJO se pide la autorización de los padres).
enum Parentesco {
  HIJO
  SOBRINO
  NIETO
  AHIJADO
  OTRO
}

// Cómo se enseñan están en el frontend; aquí solo los valores posibles.
enum Sexo {
  HOMBRE
  MUJER
}

/// Quién es el titular de la cuenta del IBAN, visto desde la ficha: el propio
/// hermano, un familiar que también es hermano, u otra persona.
enum TitularidadCuenta {
  PROPIA
  FAMILIAR_HERMANO
  OTRA_PERSONA
}

/// Por qué salió del censo. Null en las bajas de antes de guardarlo.
enum MotivoBaja {
  VOLUNTARIA
  IMPAGO
  FALLECIMIENTO
  OTRO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  PAREJA_DE_HECHO
  SEPARADO
  DIVORCIADO
  VIUDO
}

model Hermano {
  id Int @id @default(autoincrement())

  // DATOS PERSONALES
  nombre          String
  /// Los dos apellidos juntos, como se buscan, se ordenan y se enseñan. Lo
  /// escribe el servidor a partir de los dos de abajo (domain/apellidos.ts):
  /// no se toca a mano, o se desacompasaría de ellos.
  apellidos       String
  primerApellido  String?
  segundoApellido String?
  dni             String?  @unique // Puede ser null (niños)
  fechaNacimiento DateTime
  sexo            Sexo?
  estadoCivil     EstadoCivil?
  profesion       String?
  /// «Natural de»: dónde nació.
  lugarNacimiento String?

  // CONTACTO ESPECÍFICO
  telefono     String?
  telefonoFijo String?
  email        String?
  /// Un segundo correo, opcional: para quien quiere los avisos en dos sitios.
  email2       String?
  direccion    String?
  poblacion    String?
  codigoPostal String?
  provincia    String?
  comunidadAutonoma String?
  pais         String?
  /// Quiere recibir el boletín de noticias por correo.
  boletin      Boolean @default(false)

  // VIDA COFRADE
  // Bautismo y parroquia son datos religiosos (RGPD, art. 9): opcionales, y
  // solo los ven el propio hermano y la gestión del censo.
  fechaBautismo     DateTime?
  /// «Bautizado/a en»: la localidad del bautismo.
  lugarBautismo     String?
  parroquiaBautismo String?
  /// Los tres siguientes los lleva Secretaría: el hermano los ve, no los edita.
  fechaJura         DateTime?
  presentadoPor     String?
  presentadoPor2    String?

  // DATOS DE HERMANDAD
  fechaAlta DateTime  @default(now())
  activo    Boolean   @default(true) // Soft Delete del hermano
  numeroHermano   Int?      @unique // Número de hermano, si lo tienen asignado
  fechaBaja DateTime? // Para saber cuándo dejó de pagar/salir
  motivoBaja MotivoBaja?

  // VINCULACIÓN
  esTitular Boolean @default(false) // true = este perfil es el User logueado
  userId    Int
  user      User    @relation(fields: [userId], references: [id])

  /// Qué es este menor para el titular de la cuenta. Null en las fichas del
  /// propio titular y en las de antes de que existiera el campo.
  parentesco Parentesco?

  /// Cuándo pidió volver quien está de baja. La ficha de baja conserva su
  /// `fechaBaja` (borrarla perdería cuándo se fue), así que la petición se
  /// marca aquí y con eso entra en la cola de Secretaría. Se limpia al
  /// reactivarla o al rechazar la petición.
  reactivacionSolicitada DateTime?

  // --- DATOS LOGÍSTICOS (PROCESIÓN) ---

  tieneTunicaPropia Boolean @default(false)

  // TALLAJE DE ROPA (Nazarenos/Acólitos)
  // Talla genérica para previsión (Ej: "L", "42", "Niño 10")
  tunica String?

  // TALLAJE FÍSICO (Hombres de Trono)
  // Medida en cm desde suelo a hombro para cuadrar el varal (Ej: 165)
  alturaHombro Int?

  // ROL HABITUAL
  // Para mostrar en la ficha: "Fulanito (Hombre de Trono)" o "Fulanito (Músico)"
  puesto String?

  // Pago preferido para la generación de recibos (Domiciliación SEPA preparada)
  formaPagoPref MetodoPago @default(EFECTIVO)
  iban          String?
  /// Nombre del titular de la cuenta, cuando no es el propio hermano.
  titularCuenta String?
  titularidadCuenta TitularidadCuenta?

  // DOCUMENTOS DEL ALTA (en storage/private: solo los ve el CMS). Guardan el
  // nombre del fichero, no la URL, para no atarse al dominio de la API.
  foto                String?
  certificadoBautismo String?

  // HISTORIAL
  papeletas PapeletaSitio[]
  recibos   Recibo[]
  citas     Cita[]
  transacciones Transaccion[]
  prendas   Prenda[]

  // Las peticiones de reactivación son pocas y Secretaría las lee enteras cada
  // vez que abre la cola: así no hay que recorrer el censo para encontrarlas.
  @@index([reactivacionSolicitada])
}

// ---------------------------------------------------------
// 3. SISTEMA DE ASISTENCIA (EL DÍA DE REPARTO)
// ---------------------------------------------------------

// Los días que la Hermandad abre para atender
model Turno {
  id    Int      @id @default(autoincrement())
  fecha DateTime // Ej: 2024-03-15

  horaInicio DateTime // Ej: 18:00
  horaFin    DateTime // Ej: 21:00

  // Informativo: ¿Cuánta gente esperamos poder atender bien?
  capacidadEstimada Int @default(100)

  activo Boolean @default(true)

  citas Cita[] // Lista de gente que dijo que vendría

  // RELACIÓN: Miembros de la Junta que trabajan ese día
  responsables User[] @relation("TurnosResponsables")
}

// La intención de ir de un hermano
model Cita {
  id Int @id @default(autoincrement())

  // No guardamos hora exacta, solo el vínculo con el turno
  estado EstadoCita @default(RESERVADA)

  // RELACIONES
  turnoId Int
  turno   Turno @relation(fields: [turnoId], references: [id])

  hermanoId Int
  hermano   Hermano @relation(fields: [hermanoId], references: [id])

  // Opcional: Si la cita se completó, generó una papeleta
  papeleta PapeletaSitio?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restricción: Un hermano solo sale una vez por turno
  @@unique([hermanoId, turnoId])
}

// ---------------------------------------------------------
// 4. ECONOMÍA
// ---------------------------------------------------------

// Mantenemos solo el tipo básico
enum TipoTransaccion {
  INGRESO
  GASTO
}

// NUEVO: Modelo dinámico de categorías
model CategoriaTransaccion {
  id     Int             @id @default(autoincrement())
  nombre String // Ej: "Lotería Navidad", "Flores Cuaresma"
  tipo   TipoTransaccion // Para saber si debe salir en el desplegable de Ingresos o de Gastos
  activa Boolean         @default(true) // Soft-delete: si ya no venden lotería, la ocultan pero no se borra el historial

  transacciones Transaccion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El servicio ya lo comprueba, pero dos altas a la vez podían colarse. Con la
  // intercalación utf8mb4_unicode_ci el índice no distingue mayúsculas ni tildes.
  @@unique([tipo, nombre])
}

// EL LIBRO MAYOR (Actualizado)
model Transaccion {
  id   Int             @id @default(autoincrement())
  tipo TipoTransaccion

  // Enlace a la nueva tabla
  categoriaId Int
  categoria   CategoriaTransaccion @relation(fields: [categoriaId], references: [id])

  concepto   String
  importe    Decimal     @db.Decimal(10, 2)
  fecha      DateTime    @default(now())
  metodoPago MetodoPago?

  hermanoId Int?
  hermano   Hermano? @relation(fields: [hermanoId], references: [id])
  reciboId  Int?
  recibo    Recibo?  @relation(fields: [reciboId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recibo {
  id Int @id @default(autoincrement())

  year         Int // Año fiscal
  concepto     String // "Papeleta de Sitio 2024"
  importe      Decimal  @db.Decimal(10, 2)
  fechaEmision DateTime @default(now())

  tipo TipoRecibo @default(PAPELETA_SITIO)

  estado     EstadoPago  @default(PENDIENTE)
  fechaPago  DateTime?
  metodoPago MetodoPago?
  observaciones String? @db.Text

  // RELACIONES
  hermanoId Int
  hermano   Hermano       @relation(fields: [hermanoId], references: [id])
  recibos   Transaccion[] // Un recibo puede tener varias transacciones (Ej: Papeleta + Donativo)

  // Relación opcional: Si es papeleta, se rellena.
  papeleta PapeletaSitio?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year]) // <-- Búsquedas de tesorería mucho más rápidas
  @@index([hermanoId]) // <-- Para listar rápido los recibos de una familia
  @@unique([hermanoId, year, concepto])
}

// ---------------------------------------------------------
// 5. LA PROCESIÓN (PAPELETA DE SITIO)
// ---------------------------------------------------------

model PapeletaSitio {
  id   Int @id @default(autoincrement())
  year Int

  // SITIO
  puesto String // "Cirio", "Varita", "Diputado", "hombre de trono"
  tramo  String? // "Tramo 3 Virgen"
  numero Int? // Orden de antigüedad

  // ASIGNACIÓN DE MATERIAL (ROPA QUE SE LLEVA ESE AÑO)
  numTunicaAsignada   String? // Ej: "140-05" (Código inventario)
  numCapiroteAsignado String? // Ej: "135"
  observaciones       String?

  // RELACIONES
  hermanoId Int
  hermano   Hermano @relation(fields: [hermanoId], references: [id])

  // ECONOMÍA: Vinculamos al recibo que pagó esto
  reciboId Int    @unique
  recibo   Recibo @relation(fields: [reciboId], references: [id])

  // LOGÍSTICA: ¿Vino de una cita previa?
  citaId Int?  @unique
  cita   Cita? @relation(fields: [citaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restricción: Un hermano solo sale una vez por año
  @@unique([hermanoId, year])
  @@index([year])
}

// ---------------------------------------------------------
// 6. EVENTOS Y CALENDARIO
// ---------------------------------------------------------

enum TipoEvento {
  CULTO
  PROCESION
  FORMACION
  ENSAYO
  REUNION
  SOCIAL
  OTRO
}

model Evento {
  id          Int       @id @default(autoincrement())
  title       String
  description String?   @db.Text
  location    String?
  startDate   DateTime
  endDate     DateTime?

  // Todos los actos son públicos: la agenda no tiene actos solo para hermanos.
  type TipoEvento @default(OTRO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate]) // <-- Para que el calendario cargue al instante
}

// ---------------------------------------------------------
// 7. ALBACERÍA (INVENTARIO ESTÁTICO)
// ---------------------------------------------------------

// 1. LOS ENSERES (Gestión por Lotes: Hachetas, Viacrucis, Varales)
model Enser {
  id         Int     @id @default(autoincrement())
  nombre     String
  referencia String?
  categoria  String?
  ubicacion  String?

  cantidadOptimo  Int @default(0)
  cantidadBueno   Int @default(0)
  cantidadReparar Int @default(0)
  cantidadTotal   Int @default(0)

  imagenUrl        String?
  fechaAdquisicion DateTime?
}

// 2. EL ROPERO (Gestión Unitaria: Túnicas, Capirotes, Faraonas)
model Prenda {
  id            Int          @id @default(autoincrement())
  numero        String       @unique // Ej: "TUN-014", "CAP-102", "FAR-005"
  tipo          TipoPrenda // Enum a crear: TUNICA, CAPIROTE, FARAONA, CAPA
  talla         String? // Ej: "1.75m", "XL"
  estado        EstadoPrenda @default(DISPONIBLE) // Enum: DISPONIBLE, PRESTADA, TALLER, BAJA
  observaciones String?

  // Relación: ¿Quién se la ha llevado a casa?
  hermanoId       Int?
  hermano         Hermano?  @relation(fields: [hermanoId], references: [id])
  fechaAsignacion DateTime?
}

enum TipoPrenda {
  TUNICA
  CAPIROTE
  FARAONA
  CAPA
  OTRO
}

enum EstadoPrenda {
  DISPONIBLE
  PRESTADA
  TALLER
  BAJA
}

// ---------------------------------------------------------
// 8. NOTICIAS Y CONFIGURACIÓN
// ---------------------------------------------------------

model Noticia {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  titulo    String
  extracto  String?
  contenido String   @db.Text
  imagenUrl String?
  fecha     DateTime @default(now())
  visible   Boolean  @default(true)
  /// La destacada de la portada: encabeza la rejilla y las otras dos plazas
  /// siguen siendo las más recientes. Solo una a la vez (fijar una suelta la
  /// anterior) y solo si está publicada. El archivo no la mira: ahí manda la fecha.
  fijada    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La web pública filtra por visible y ordena por fecha; el CMS ordena por
  // fecha sin filtrar. Mismo par de índices que Publicacion, que se consulta igual.
  @@index([visible, fecha])
  @@index([fecha])
}

enum TipoPublicacion {
  boletin
  dossier
  anuario
  historia
}

model Publicacion {
  id          Int             @id @default(autoincrement())
  titulo      String
  descripcion String?         @db.Text
  imagenUrl   String?
  archivoUrl  String
  fecha       DateTime        @default(now())
  categoria   TipoPublicacion
  visible     Boolean         @default(true)
  /// La destacada de la portada, igual que en Noticia: una sola, publicada, y
  /// ocupa el puesto grande del bloque de Publicaciones.
  fijada      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoria, fecha])
  @@index([visible, fecha])
}

model Configuracion {
  key         String   @id
  value       String
  descripcion String?
  updatedAt   DateTime @updatedAt
}

// Códigos de respaldo del 2FA: se muestran UNA sola vez al activar,
// y cada uno puede usarse una única vez (para login o para desactivar).
model TwoFactorBackupCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Registro de auditoría de acciones sensibles (dinero, roles, solicitudes, RGPD).
// Es la prueba forense de quién hizo qué, cuándo y desde qué IP.
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // Ej: 'RECIBO_COBRAR', 'SOLICITUD_APROBAR' (ver AUDIT_ACTIONS)
  entityType String? // 'recibo', 'hermano', 'user', 'config'...
  entityId   String? // ID del registro afectado (string para flexibilidad)
  ip         String?
  userAgent  String? @db.VarChar(250)
  // Estado anterior y nuevo, u otros datos que expliquen el cambio.
  detalles   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Pagina {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  titulo    String
  contenido String   @db.Text
  updatedAt DateTime @updatedAt
}

// Fotos que rotan en la cabecera de la portada, en el orden en que se enseñan.
// El CMS las sustituye en bloque (PUT /api/portada/imagenes); con la tabla
// vacía, la web pública enseña su foto de siempre.
model ImagenPortada {
  id          Int      @id @default(autoincrement())
  url         String
  descripcion String?
  orden       Int
  createdAt   DateTime @default(now())

  @@index([orden])
}

// Contenido editable de una página: un documento por página, validado contra su
// esquema antes de escribirse. La ESTRUCTURA la fija el código (qué bloques hay
// y en qué orden); esto guarda solo lo que dentro de ella se puede cambiar,
// textos e imágenes. Dos filas: 'portada' y 'recorrido'.
//
// OJO: si un campo de `datos` apunta a /storage/public, tiene que contar en
// `utils/ficheros-publicos.ts` o el limpiador de huérfanos borrará la foto
// estando publicada.
model ContenidoPagina {
  slug      String   @id
  datos     Json
  updatedAt DateTime @updatedAt
}
