# Imagen de PRODUCCIÓN del backend.
# Construir:  docker build -t backend-desamparados:prod -f Dockerfile.prod .
# Ejecutar:   docker run -d --env-file .env.production -p 3001:3001 backend-desamparados:prod
#
# Requiere en .env.production:
#   NODE_ENV=production, JWT_SECRET (>= 32 chars, ver npm run gen:secret),
#   FRONTEND_URL, NUM_PROXIES (según proxy real), credenciales de BD.

FROM node:22-alpine
WORKDIR /app

# Dependencias (capa cacheada: solo se reinstala si cambia package*.json)
# Nota: instalamos todo (incluye tsx, que está en devDependencies) porque la app
# ejecuta TypeScript directamente sin paso de build.
COPY package*.json ./
RUN npm ci

# Código con permisos del usuario 'node' (nunca root)
COPY --chown=node:node . .
RUN npx prisma generate

USER node

ENV NODE_ENV=production
EXPOSE 3001

# El orquestador (docker run/k8s) puede leer el estado del contenedor
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/health || exit 1

# Sin nodemon ni debugger: solo el proceso Node
CMD ["node", "--import", "tsx", "src/index.ts"]
