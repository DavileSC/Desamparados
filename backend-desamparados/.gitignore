# Dependencias (pesan mucho y se instalan solas con npm install)
node_modules/
dist/
build/

# Variables de entorno (¡SEGURIDAD! Nunca subas tus claves)
.env
.env.local
.env.test

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Archivos del sistema
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Prisma (Opcional, si usaras SQLite no se sube la DB local)
*.sqlite
*.sqlite-journal

# Herramientas de empaquetado del repositorio (repomix)
repomix-output.xml
# Copias de seguridad (scripts/backup-db.ps1 y scripts/backup-vps.sh) y
# volcados sueltos: llevan datos personales de todo el censo.
backups/
*.sql
*.sql.gz
*.age
# ...salvo las migraciones de Prisma, que sí se versionan.
!prisma/migrations/**/*.sql

# Lo que deja tsc al comprobar los tipos (npm run comprobar-tipos).
*.tsbuildinfo

# Los números que deja scripts/carga.mjs: de una prueba concreta, no del código.
carga-resultado*.json
