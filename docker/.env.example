# Plantilla del .env que lee docker compose. Cópiala a la RAÍZ del repositorio
# con el nombre `.env` y rellénala:
#
#   cp docker/.env.ejemplo .env
#
# Es un fichero distinto de backend-desamparados/.env (el que se usa para
# trabajar fuera de Docker). Con el compose, la API no lee aquel: recibe estas
# variables del entorno, y dotenv no pisa lo que ya viene del entorno.
#
# Compose lo usa para dos cosas: sustituir las ${VARIABLES} del compose.yaml y
# pasárselo entero al contenedor de la API. Por eso aquí conviven las
# variables de la aplicación y las del despliegue.
#
# NO lo subas a git: lleva los secretos. El .gitignore ya lo excluye.
#
# Estas las pone el compose y no hace falta escribirlas: NODE_ENV, HOST, PORT,
# DATABASE_HOST, DATABASE_URL, CLAMAV_HOST y CLAMAV_PORT.

# ============================================================
# QUÉ SE LEVANTA
# ============================================================
# Perfiles activos. En el servidor, los dos:
#   antivirus  el contenedor de ClamAV. Sin él, todas las subidas dan 503.
#   tls        la renovación del certificado de Let's Encrypt.
# Para la prueba en local se puede dejar solo `antivirus`, o vaciarlo si no se
# van a probar las subidas (tarda varios minutos en bajar las firmas).
COMPOSE_PROFILES=antivirus,tls

# Dueño de los archivos subidos. `storage/` en el servidor tiene que
# pertenecer a este usuario; compruébalo con `id -u` y `id -g`.
APP_UID=1000
APP_GID=1000

# ============================================================
# BASE DE DATOS
# ============================================================
# La contraseña viaja dentro de DATABASE_URL, que el compose arma con estas
# piezas. Genérala SIN caracteres que haya que codificar en una URL (nada de
# @ : / # ? &):
#   openssl rand -base64 30 | tr -dc 'A-Za-z0-9' | head -c 32
DATABASE_NAME=desamparados_db
DATABASE_USER=desamparados
DATABASE_PASSWORD=
# Solo la usa el contenedor de MariaDB, para su propio root. La aplicación
# nunca entra con ella.
DATABASE_ROOT_PASSWORD=

# ============================================================
# SECRETOS DE LA APLICACIÓN
# ============================================================
# Firma de las sesiones, 32 caracteres como mínimo:
#   docker compose run --rm herramientas npm run gen:secret
JWT_SECRET=

# Clave de cifrado del secreto del doble factor, exactamente 64 hexadecimales:
#   docker compose run --rm herramientas npm run gen:clave-totp
# Si se pierde, todos los cargos tienen que volver a activar el doble factor:
# guárdala también fuera del servidor. Para cambiarla, «Rotar TOTP_ENC_KEY» en
# docs/despliegue.md.
TOTP_ENC_KEY=

# Solo durante una rotación de TOTP_ENC_KEY. Ver la guía antes de tocarla.
# TOTP_ENC_KEY_ANTERIOR=

# ============================================================
# DOMINIO
# ============================================================
# Con https:// y sin barra final. Los dos son el mismo dominio: la web y la
# API comparten origen y la cookie de sesión es SameSite=Strict.
# En local: https://localhost:8443
FRONTEND_URL=https://www.desamparadosmalaga.com
API_URL=https://www.desamparadosmalaga.com

# Cuántos proxies hay delante. Con este montaje hay uno (el nginx del
# compose); 2 si además se pone Cloudflare por delante.
NUM_PROXIES=1

# ============================================================
# ANTIVIRUS
# ============================================================
# Obligatoria en producción y tiene que ser true: ningún archivo se publica
# sin pasar por el antivirus. Si clamd se cae, las subidas fallan hasta que
# vuelva, que es lo que se quiere.
CLAMAV_REQUIRED=true

# ============================================================
# CORREO
# ============================================================
EMAIL_USER=
EMAIL_PASS=
# Nombre del remitente. Por defecto, «Secretaría».
# EMAIL_FROM_NAME=
# Destinatario del formulario de contacto. Por defecto, EMAIL_USER.
# CONTACT_EMAIL_TO=
# Cuenta aparte para el formulario de contacto. Sin ellas, la de EMAIL_USER.
# CONTACT_EMAIL_USER=
# CONTACT_EMAIL_PASS=

# ============================================================
# OPCIONALES
# ============================================================
# Peticiones a la API por IP cada 15 minutos. Por defecto 1000. Solo se sube
# para las pruebas de carga (salen todas de una IP), y se quita al acabar.
# LIMITE_GLOBAL_POR_IP=1000
# Días que se conserva la auditoría. Por defecto 730; mínimo 30.
# AUDIT_RETENTION_DAYS=730
# Enlace a la normativa en los correos. Sin ella, no aparece.
# NORMATIVA_URL=

# Pago en línea con el TPV virtual del banco (ver docs/despliegue.md, «El pago
# en línea»). Sin PAGO_EN_LINEA, apagado: se paga en Secretaría.
# PAGO_EN_LINEA=redsys
# REDSYS_ENTORNO=pruebas     # «real» cobra de verdad
# REDSYS_COMERCIO=
# REDSYS_TERMINAL=1
# REDSYS_CLAVE=
# REDSYS_BIZUM=si            # solo si el banco lo ha activado

# Solo para la siembra inicial. En producción es obligatoria y tiene que ser
# un correo real del Grupo Parroquial: allí llega el administrador.
SEED_ADMIN_EMAIL=

# ============================================================
# COPIAS DE SEGURIDAD (las lee scripts/backup-vps.sh)
# ============================================================
# Clave PÚBLICA de age. La privada no debe estar en el servidor.
# BACKUP_AGE_RECIPIENT=age1...
# O un fichero con varias:
# BACKUP_AGE_RECIPIENTS=/etc/desamparados/claves-age.txt
# BACKUP_DIR=/var/backups/desamparados
# BACKUP_RETENTION_DAYS=14
# Destino de rclone. Sin él, la copia solo vive en el mismo servidor.
# BACKUP_RCLONE_REMOTE=copias:grupo-parroquial/desamparados
