# URL base de la API del backend (con el prefijo /api).
# - En desarrollo puedes dejarla vacía: Vite proxyea /api -> VITE_DEV_BACKEND_URL (por defecto http://localhost:3001).
# - En producción, si la web y la API no comparten dominio, indícala aquí.
VITE_API_URL=
VITE_DEV_BACKEND_URL=http://localhost:3001
