# Dependencies and generated builds
**/node_modules/
**/dist/
**/build/
**/coverage/

# Environment files and local secrets
.env
.env.*
!.env.example

# Logs and local databases
*.log
*.sqlite
*.sqlite-journal
**/logs/

# Runtime uploads and local storage
backend-desamparados/storage/*
!backend-desamparados/storage/.gitkeep

# Local tooling and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
repomix-output.xml

# Bocetos del companion visual de brainstorming
.superpowers/

# Capturas y borradores de las sesiones de trabajo
.tmp/

# Copias de seguridad y volcados de la base de datos: llevan el censo entero
# (nombres, DNI, direcciones). Nunca al repositorio, ni cifradas.
**/backups/
*.sql
*.sql.gz
*.age
# ...salvo las migraciones de Prisma, que sí se versionan.
!backend-desamparados/prisma/migrations/**/*.sql
