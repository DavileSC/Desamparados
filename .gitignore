# Dependencies and generated builds
**/node_modules/
**/dist/
**/build/
**/coverage/

# Environment files and local secrets
.env
.env.*
!.env.example

# Logs and local databases
*.log
*.sqlite
*.sqlite-journal
**/logs/

# Runtime uploads and local storage
backend-desamparados/storage/*
!backend-desamparados/storage/.gitkeep

# Local tooling and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
repomix-output.xml

# Bocetos del companion visual de brainstorming
.superpowers/

# Capturas y borradores de las sesiones de trabajo
.tmp/

# Copias de seguridad y volcados de la base de datos: llevan el censo entero
# (nombres, DNI, direcciones). Nunca al repositorio, ni cifradas.
**/backups/
*.sql
*.sql.gz
*.age
# ...salvo las migraciones de Prisma, que sí se versionan.
!backend-desamparados/prisma/migrations/**/*.sql

# Capturas y volcados del MCP de Playwright: son de una sesión, no del proyecto.
.playwright-mcp/

# Grafo de graphify: se versiona para que los dos PC consulten el mismo, salvo
# la caché y los punteros al Python y a la carpeta de este equipo.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root

# Lo de cada instalación: los datos de la corporación (se crean copiando
# shared/datos-entidad.ejemplo.json). En git chocarían con cada cliente en cada
# «git pull». Lo que la web escribe de ellos (index.html relleno, manifest,
# robots.txt, instalacion.js) ya no se genera en la carpeta de la web: lo
# escribe el contenedor al arrancar y, en desarrollo, lo sirve el plugin de Vite.
/instalacion/
